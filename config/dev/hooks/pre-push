#!/bin/sh
# Pre-push hook: builds the exact commit you are pushing (not your working folder) in a temporary
# checkout and cancels the push if the build, tests, checkstyle or formatting fail.
#
# Only the newest commit of each pushed branch is checked, so earlier commits in the same push can
# be broken as long as the last one builds.
#
# Installed automatically by the installGitHooks task in build.gradle (sets core.hooksPath).
# Emergency skip: git push --no-verify

git rev-parse --show-toplevel >/dev/null || exit 1
status=0
seen=""
user_java_home=$JAVA_HOME

# Major version of the JDK at $1 from its release file, e.g. JAVA_VERSION="25.0.4.1" -> 25
jdk_major() {
    v=$(sed -n 's/^JAVA_VERSION="\([0-9._]*\)".*/\1/p' "$1/release" 2>/dev/null)
    case "$v" in 1.*) v=${v#1.} ;; esac
    echo "${v%%[._]*}"
}

# Prints the JAVA_HOME to build with for a project that needs JDK $1. Prints nothing when the java
# already on PATH matches, and returns 1 when no matching JDK can be found.
find_jdk() {
    need=$1
    if [ -z "$need" ]; then
        echo "$user_java_home"
        return 0
    fi
    if [ -n "$user_java_home" ] && [ "$(jdk_major "$user_java_home")" = "$need" ]; then
        echo "$user_java_home"
        return 0
    fi
    # Every WPILib install (2026, 2027_alpha7, 2027, ...) ships its own JDK
    for jdk in "$HOME"/wpilib/*/jdk /c/Users/Public/wpilib/*/jdk; do
        if [ -f "$jdk/release" ] && [ "$(jdk_major "$jdk")" = "$need" ]; then
            echo "$jdk"
            return 0
        fi
    done
    path_version=$(java -version 2>&1 | sed -n 's/.*version "\([0-9._]*\)".*/\1/p')
    case "$path_version" in 1.*) path_version=${path_version#1.} ;; esac
    if [ -z "$user_java_home" ] && [ "${path_version%%[._]*}" = "$need" ]; then
        return 0
    fi
    return 1
}

while read -r local_ref local_sha remote_ref remote_sha; do
    # Deleting a remote branch sends an all-zero sha, nothing to build
    case "$local_sha" in
        *[!0]*) ;;
        *) continue ;;
    esac
    # Pushing several branches that point at the same commit only needs one build
    case " $seen " in
        *" $local_sha "*) continue ;;
    esac
    seen="$seen $local_sha"

    short=$(git rev-parse --short "$local_sha")
    tmp=$(mktemp -d "${TMPDIR:-/tmp}/pre-push.XXXXXX")
    echo "pre-push: building $short ($local_ref) in a clean checkout..."
    if ! git worktree add --quiet --detach "$tmp" "$local_sha"; then
        status=1
        break
    fi

    # Build with a JDK matching this commit's sourceCompatibility (17 for 2026, 25 for 2027, ...)
    need=$(sed -n -e 's/.*JavaVersion\.VERSION_\([0-9]*\).*/\1/p' \
        -e 's/.*JavaLanguageVersion\.of(\([0-9]*\)).*/\1/p' "$tmp/build.gradle" | head -n 1)
    if ! java_home=$(find_jdk "$need"); then
        echo "pre-push: $short needs JDK $need. Install the matching WPILib or set JAVA_HOME to a JDK $need."
        git worktree remove --force "$tmp"
        status=1
        break
    fi

    # </dev/null so gradle can't eat the ref list git sends on stdin
    if (cd "$tmp" && JAVA_HOME=$java_home ./gradlew build -PstrictCheckstyle --quiet </dev/null); then
        # compileJava runs spotlessApply, so a changed file means the commit wasn't formatted
        if [ -n "$(git -C "$tmp" status --porcelain --untracked-files=no)" ]; then
            echo "pre-push: $short isn't formatted. Run ./gradlew build, commit the changes and push again:"
            git -C "$tmp" status --short --untracked-files=no
            status=1
        fi
    else
        echo "pre-push: build failed for $short, push cancelled (scroll up for the errors)."
        status=1
    fi

    git worktree remove --force "$tmp"
    if [ $status -ne 0 ]; then
        break
    fi
done

exit $status
